# Public build-time settings. Confirm the exact Google Maps listing first.
VITE_GOOGLE_MAPS_URL=
VITE_GOOGLE_MAPS_EMBED_URL=
VITE_GOOGLE_PLACE_ID=
# Enable only on a host serving api/reviews.mjs, with the secrets below set.
VITE_LIVE_REVIEWS=false

# SERVER ONLY. Never use VITE_ for secrets. Set these in your hosting dashboard.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# SERVER ONLY. All reviews from the owner's Google Business Profile (preferred).
# Run scripts/google-business-setup.mjs once to get the refresh token and location.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_LOCATION=
GOOGLE_MAPS_URL=https://maps.google.com/?cid=3854993009221938151
